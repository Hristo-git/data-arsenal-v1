#!/usr/bin/env python3
"""
Data Arsenal v1 - Setup Script
Installs dependencies, runs OAuth or API key setup, copies scripts, verifies access.
"""

import os
import sys
import subprocess
import shutil
import json
import webbrowser

CONFIG_DIR = os.path.expanduser('~/.config/data-arsenal')
SCRIPTS_DIR = os.path.join(CONFIG_DIR, 'scripts')
CONTEXTS_DIR = os.path.join(CONFIG_DIR, 'contexts')
PROJECTS_DIR = os.path.join(CONFIG_DIR, 'projects')
VENV_DIR = os.path.join(CONFIG_DIR, 'venv')
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_DIR = os.path.dirname(SCRIPT_DIR)

# Cloud mode only needs fpdf2 (for local PDF). Local mode needs Google packages too.
BASE_PACKAGES = ['fpdf2']
GOOGLE_PACKAGES = [
    'google-auth',
    'google-auth-oauthlib',
    'google-api-python-client',
]

LANG_CODES = {
    'English': 'en',
    'Bulgarian': 'bg',
}


def check_python():
    """Verify Python >= 3.8."""
    if sys.version_info < (3, 8):
        print(f"Python 3.8+ required, found {sys.version}")
        sys.exit(1)
    print(f"Python {sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")


def ensure_venv():
    """Create venv automatically if system Python restricts pip."""
    if sys.prefix != sys.base_prefix:
        return  # Already in a venv

    result = subprocess.run(
        [sys.executable, '-m', 'pip', 'install', '--dry-run', 'pip'],
        capture_output=True, text=True
    )
    if 'externally-managed-environment' not in result.stderr:
        return  # pip works fine

    print("\nSystem Python restricts pip. Creating virtual environment...")
    os.makedirs(CONFIG_DIR, exist_ok=True)
    subprocess.run([sys.executable, '-m', 'venv', VENV_DIR], check=True)
    venv_python = os.path.join(VENV_DIR, 'bin', 'python3')
    if os.name == 'nt':
        venv_python = os.path.join(VENV_DIR, 'Scripts', 'python.exe')
    print("Restarting setup with virtual environment...\n")
    os.execv(venv_python, [venv_python] + sys.argv)


def install_deps(packages):
    """Install required Python packages."""
    print("\nChecking dependencies...")
    missing = []
    for pkg in packages:
        try:
            mod_name = pkg.replace('-', '_').replace('google_api_python_client', 'googleapiclient')
            __import__(mod_name)
        except ImportError:
            missing.append(pkg)

    if missing:
        print(f"Installing: {', '.join(missing)}")
        cmd = [sys.executable, '-m', 'pip', 'install'] + missing
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"pip install failed:\n{result.stderr}")
            sys.exit(1)
        print("Dependencies installed.")
    else:
        print("All dependencies present.")


def ask_mode():
    """Ask user which setup mode to use."""
    print("\n" + "=" * 60)
    print("How would you like to connect to Google Analytics?")
    print("=" * 60)
    print()
    print("  1. Easy (recommended) - Use your dataarsenal.com account")
    print("     Sign up at dataarsenal.com, connect GA4, get an API key.")
    print("     50 checks, no local Google OAuth needed.")
    print()
    print("  2. Advanced - Local Google OAuth")
    print("     Authenticate directly with Google. 16 built-in checks.")
    print("     No account needed, everything runs locally.")
    print()
    response = input("Choice [1]: ").strip()
    if response == '2':
        return 'local'
    return 'cloud'


def setup_cloud():
    """Cloud mode setup - get API key from dataarsenal.com."""
    print("\n--- Cloud Setup (dataarsenal.com) ---\n")
    print("You need an API key from dataarsenal.com.")
    print("If you don't have one yet:")
    print("  1. Go to dataarsenal.com")
    print("  2. Create an account (or sign in)")
    print("  3. Connect your GA4 property")
    print("  4. Copy your API key from Settings")
    print()

    open_browser = input("Open dataarsenal.com in browser? [Y/n]: ").strip().lower()
    if open_browser != 'n':
        webbrowser.open('https://dataarsenal.com')
        print("Browser opened. Get your API key and paste it below.\n")

    api_key = input("API key: ").strip()
    if not api_key:
        print("No API key entered. Setup cancelled.")
        sys.exit(1)

    # Verify the key works
    print("\nVerifying API key...")
    sys.path.insert(0, SCRIPT_DIR)
    from _ga4_lib import cloud_verify, cloud_list_properties

    if not cloud_verify(api_key):
        print("API key verification failed. Check your key and try again.")
        sys.exit(1)

    print("API key verified.")

    # Show properties
    try:
        properties = cloud_list_properties(api_key)
        if properties:
            print(f"\nFound {len(properties)} GA4 properties:\n")
            print(f"{'Property ID':<15} {'Property Name'}")
            print(f"{'-'*15} {'-'*30}")
            for p in properties[:20]:
                print(f"{p['property_id']:<15} {p['display_name'][:30]}")
            if len(properties) > 20:
                print(f"  ... and {len(properties) - 20} more")
        else:
            print("\nNo GA4 properties found. Connect a property at dataarsenal.com.")
    except Exception as e:
        print(f"\nCould not list properties: {e}")

    return api_key


def setup_local():
    """Local mode setup - OAuth flow."""
    print("\n--- Local Setup (Google OAuth) ---\n")

    # Install Google packages
    install_deps(GOOGLE_PACKAGES)

    sys.path.insert(0, SCRIPT_DIR)
    from _ga4_lib import authenticate, CREDENTIALS_FILE

    if os.path.exists(CREDENTIALS_FILE):
        print(f"Existing credentials found at {CREDENTIALS_FILE}")
        response = input("Re-authenticate? [y/N]: ").strip().lower()
        if response != 'y':
            print("Keeping existing credentials.")
            return

    print("\nOpening browser for Google sign-in...")
    print("Grant read-only access to Google Analytics.\n")
    authenticate()
    print("Authentication successful.")


def ask_language():
    """Ask preferred language for analysis output."""
    print("\nPreferred language for analysis output?")
    print("  1. English (default)")
    print("  2. Bulgarian")
    print("  3. Other (type language name)")
    response = input("\nChoice [1]: ").strip()
    if not response or response == '1':
        return 'English'
    if response == '2':
        return 'Bulgarian'
    if response == '3' or not response.isdigit():
        lang = response if not response.isdigit() else input("Language name: ").strip()
        return lang if lang else 'English'
    return 'English'


def copy_scripts(language='English', mode='local', api_key=None):
    """Copy scripts, contexts, fonts, and CLAUDE.md to ~/.config/data-arsenal/."""
    os.makedirs(SCRIPTS_DIR, exist_ok=True)
    os.makedirs(PROJECTS_DIR, exist_ok=True)

    python_path = sys.executable

    # Copy scripts
    scripts = ['_ga4_lib.py', '_translations.py', '_pdf_report.py',
               'ga4-what-changed', 'ga4-audit', 'ga4-report']
    copied = 0
    for script in scripts:
        src = os.path.join(SCRIPT_DIR, script)
        dst = os.path.join(SCRIPTS_DIR, script)
        if os.path.exists(src):
            # Remove existing file/symlink before creating new symlink
            if os.path.exists(dst) or os.path.islink(dst):
                os.remove(dst)
            os.symlink(src, dst)
            if not script.endswith('.py'):
                # Ensure repo file is executable
                os.chmod(src, 0o755)
            copied += 1

    print(f"\nLinked {copied} scripts to {SCRIPTS_DIR} (synced with repo)")

    # Copy fonts directory
    fonts_src = os.path.join(SCRIPT_DIR, 'fonts')
    fonts_dst = os.path.join(SCRIPTS_DIR, 'fonts')
    if os.path.isdir(fonts_src):
        os.makedirs(fonts_dst, exist_ok=True)
        font_count = 0
        for f in os.listdir(fonts_src):
            if f.endswith('.ttf'):
                shutil.copy2(os.path.join(fonts_src, f), os.path.join(fonts_dst, f))
                font_count += 1
        print(f"Copied {font_count} font files to {fonts_dst}")

    # Copy contexts directory
    contexts_src = os.path.join(REPO_DIR, 'contexts')
    if os.path.exists(contexts_src):
        shutil.copytree(contexts_src, CONTEXTS_DIR, dirs_exist_ok=True)
        context_count = len([f for f in os.listdir(CONTEXTS_DIR) if f.endswith('.md')])
        print(f"Copied {context_count} context files to {CONTEXTS_DIR}")

    # Copy CLAUDE.md
    claude_md_src = os.path.join(REPO_DIR, 'CLAUDE.md')
    if os.path.exists(claude_md_src):
        shutil.copy2(claude_md_src, os.path.join(CONFIG_DIR, 'CLAUDE.md'))
        print(f"Copied CLAUDE.md to {CONFIG_DIR}")

    # Save config
    language_code = LANG_CODES.get(language, 'en')
    config = {
        'repo_path': REPO_DIR,
        'version': '1.0.0',
        'python_path': python_path,
        'venv': sys.prefix != sys.base_prefix,
        'language': language,
        'language_code': language_code,
        'mode': mode,
    }
    if mode == 'cloud' and api_key:
        config['api_key'] = api_key

    config_path = os.path.join(CONFIG_DIR, 'config.json')
    with open(config_path, 'w') as f:
        json.dump(config, f, indent=2)
    print(f"Saved config to {config_path}")


def verify_local_access():
    """Verify local API access by listing properties."""
    sys.path.insert(0, SCRIPT_DIR)
    from _ga4_lib import load_credentials, list_properties

    print("\nVerifying API access...")
    creds = load_credentials()
    if not creds:
        print("Failed to load credentials.")
        sys.exit(1)

    try:
        properties = list_properties(creds)
    except Exception as e:
        print(f"API verification failed: {e}")
        sys.exit(1)

    if not properties:
        print("No GA4 properties found. Check that your account has Analytics access.")
        return

    print(f"\nFound {len(properties)} GA4 properties:\n")
    print(f"{'Property ID':<15} {'Account':<30} {'Property Name'}")
    print(f"{'-'*15} {'-'*30} {'-'*30}")
    for p in properties[:20]:
        print(f"{p['property_id']:<15} {p['account_name'][:30]:<30} {p['display_name'][:30]}")
    if len(properties) > 20:
        print(f"  ... and {len(properties) - 20} more")


def print_next_steps(mode='local'):
    """Print what to do next."""
    print("\n" + "=" * 60)
    print("Setup complete!")
    print("=" * 60)

    checks = "50 cloud checks" if mode == 'cloud' else "16 local checks"
    print(f"\nMode: {'Cloud (dataarsenal.com)' if mode == 'cloud' else 'Local (Google OAuth)'}")
    print(f"Checks: {checks}")

    print(f"""
Next steps:
  /ga4-audit <property_id>     Health check ({checks})
  /ga4-brief <property_id>     What-changed analysis
  /ga4-context <client>        Create business context file

Or run scripts directly:
  ~/.config/data-arsenal/scripts/ga4-audit <property_id>
  ~/.config/data-arsenal/scripts/ga4-audit <property_id> --format pdf
  ~/.config/data-arsenal/scripts/ga4-what-changed <property_id>
""")


def main():
    print("Data Arsenal v1 - Setup\n")

    ensure_venv()
    check_python()
    install_deps(BASE_PACKAGES)

    mode = ask_mode()
    api_key = None

    if mode == 'cloud':
        api_key = setup_cloud()
    else:
        setup_local()

    language = ask_language()
    copy_scripts(language, mode=mode, api_key=api_key)

    if mode == 'local':
        verify_local_access()

    print_next_steps(mode=mode)


if __name__ == '__main__':
    main()
